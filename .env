# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=demo_user
DB_PASSWORD=demo_password
DB_BASE_NAME=ultimate_demo

# Prisma Database URL (constructed from above variables)
# DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_BASE_NAME}

# Temporary SQLite for development (comment out PostgreSQL line above)
DATABASE_URL=file:./dev.db

# Demo Configuration
CONTAINER_COUNT=5
SCHEMAS_PER_CONTAINER=4
MICROSERVICES_COUNT=20
ENABLE_FILE_LOGGING=true
LOG_LEVEL=info

# Performance Configuration
MAX_PARALLEL_OPERATIONS=60
PROCESSING_TIME_MIN=100
PROCESSING_TIME_MAX=1500
MEMORY_THRESHOLD_MB=100

# Server Configuration
PORT=3000
HOST=localhost

# Docker Configuration
DOCKER_POSTGRES_IMAGE=postgres:15
CONTAINER_PREFIX=ultimate-demo

# Logging Configuration
LOG_FILE_PATH=./logs/ultimate-production-demo.log
REPORTS_PATH=./reports
