{
  "name": "testing-ultimate-production-demo",
  "version": "2.0.0",
  "description": "🚀 Ultimate Production Demo - 20 Enterprise Microservices with Advanced Memory Management",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "demo": "vitest run src/__tests__/ultimateProductionDemo.test.ts --reporter=verbose",
    "demo:ultimate": "vitest run src/__tests__/ultimateProductionDemo.test.ts --reporter=verbose --no-coverage",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "setup": "tsx scripts/setup.ts",
    "cleanup": "tsx scripts/cleanup.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "dockerode": "^4.0.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "prisma": "^5.11.0",
    "testcontainers": "^10.7.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^3.2.4",
    "chalk": "^5.6.2",
    "cli-spinners": "^3.3.0",
    "jsdom": "^23.0.1",
    "ora": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "microservices",
    "demo",
    "production",
    "enterprise",
    "architecture",
    "postgresql",
    "docker",
    "vitest"
  ],
  "author": "Ashley",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
